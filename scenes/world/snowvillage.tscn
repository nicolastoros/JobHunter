[node name="Citizen1" parent="Entities/Citizens" instance=ExtResource("17_walker")]
position = Vector2(677.871, 656)
frames = ExtResource("18_npc_citize")
sprite_offset_y = -13
npc_name = "Vecino"
lines = PackedStringArray("En invierno el camino al sur se cierra con la nieve.", "Bjorn forja con hierro que nunca se oxida.", "¿Has visto al Ent Invernal? Mi abuelo sí.", "El fuego de la plaza no se apaga desde hace cien años.", "Las pieles de lobo blanco se pagan bien.", "Qué frío hace hoy...", "Los yetis bajan cuando nieva fuerte.", "Hilda sirve la mejor sopa de todo el norte.", "Dicen que bajo el lago hay un limo enorme.")
start_node = 1
tint = Color(0.946, 0.902, 0.934, 1)
brain = true
mode = "stroller"

