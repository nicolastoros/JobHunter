[node name="Elder" parent="Entities/Actors" instance=ExtResource("9_actor")]
position = Vector2(992, 760)
frames = ExtResource("12_actor_46a3")
sprite_offset = Vector2(0, -9)
npc_name = "Anciana Freya"
lines = PackedStringArray("El fuego de esta plaza lleva cien años encendido. Yo lo vi encender.", "Las canciones antiguas hablan de tres Sellos... pero ya nadie las canta.")
shouts = PackedStringArray("Acércate al fuego.", "Las canciones antiguas...")

[node name="TraderLute" parent="Entities/Actors" instance=ExtResource("9_actor")]
position = Vector2(832, 720)
frames = ExtResource("13_actor_421d")
sprite_offset = Vector2(0, -9)
npc_name = "Bardo Olaf"
lines = PackedStringArray("Canto al fuego que nunca se apaga. Siéntate, viajero.")
shouts = PackedStringArray("♪ ♪")

[node name="TraderWeapon" parent="Entities/Actors" instance=ExtResource("9_actor")]
position = Vector2(1203.2, 832)
frames = ExtResource("14_actor_5fe1")
sprite_offset = Vector2(0, -11)
npc_name = "Bjorn, el herrero del norte"
lines = PackedStringArray("El frío templa el acero mejor que cualquier fragua. Te mejoro el equipo o te compro lo que te sobre.")
shouts = PackedStringArray("Acero del norte.", "¿Traes pieles?")
seller = true
opens = "forge"

[node name="TraderDrinks" parent="Entities/Actors" instance=ExtResource("9_actor")]
