sprite_offset = Vector2(0, -13)
npc_name = "Ingrid la alquimista"
lines = PackedStringArray("Tónicos calientes. En el norte, el frío mata más que las bestias.")
seller = true

[node name="TraderBread" parent="Entities/Actors" instance=ExtResource("9_actor")]
