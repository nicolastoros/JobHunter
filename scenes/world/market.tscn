[node name="TraderFruits" parent="Entities/NPCs" instance=ExtResource("4_trader")]
position = Vector2(208, 216)
frames = ExtResource("12_npc_trader_f")
sprite_offset_y = -4
npc_name = "Tomás el frutero"
lines = PackedStringArray("¡Manzanas del valle, melones del sur! Come bien, cazador: allá afuera no hay mesas servidas.")

[node name="TraderWeapon" parent="Entities/NPCs" instance=ExtResource("4_trader")]
position = Vector2(504, 214)
frames = ExtResource("13_npc_trader_w")
sprite_offset_y = -11
npc_name = "Kara la armera"
lines = PackedStringArray("Lanzas, espadas, escudos... Todo forjado aquí mismo. Los monstruos no perdonan al que va desarmado.")

[node name="TraderMagic" parent="Entities/NPCs" instance=ExtResource("4_trader")]
position = Vector2(216, 452)
frames = ExtResource("14_npc_trader_m")
sprite_offset_y = -7
npc_name = "Morga la vidente"
lines = PackedStringArray("Las cartas hablan de bestias en el bosque del norte... y de un cazador que aún no conoce su destino.")

[node name="TraderBread" parent="Entities/NPCs" instance=ExtResource("4_trader")]
position = Vector2(552, 376)
frames = ExtResource("15_npc_trader_b")
sprite_offset_y = -11
npc_name = "Rosa la panadera"
lines = PackedStringArray("Pan de centeno recién salido del horno. ¡Ningún cazador se va de aquí con el estómago vacío!")

[node name="TraderDrinks" parent="Entities/NPCs" instance=ExtResource("4_trader")]
position = Vector2(640, 420)
frames = ExtResource("16_npc_trader_d")
sprite_offset_y = -13
npc_name = "Ezra el alquimista"
lines = PackedStringArray("Pociones de vida, tónicos de vigor... Cuando un monstruo te muerda, me lo agradecerás.")

[node name="Eater" parent="Entities/NPCs" instance=ExtResource("4_trader")]
position = Vector2(616.6, 491.4)
frames = ExtResource("17_npc_eater")
sprite_offset_y = -7
npc_name = "Viajero hambriento"
lines = PackedStringArray("Mmm... El estofado de Rosa es lo mejor de todo Valdoria. *ñam*")

[node name="Lute" parent="Entities/NPCs" instance=ExtResource("4_trader")]
position = Vector2(352, 340)
frames = ExtResource("18_npc_lute")
sprite_offset_y = -9
npc_name = "Bardo Anselmo"
lines = PackedStringArray("♪ Oh, cazador de ojos fieros, que al bosque vas sin compañeros... ♪", "¿Una moneda para el bardo? ¿No? Bueno, la música es gratis... por hoy.")

[node name="Flutist" parent="Entities/NPCs" instance=ExtResource("4_trader")]
