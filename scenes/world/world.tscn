position = Vector2(1904, 1859.2)
frames = ExtResource("55_actor_46a3")
sprite_offset = Vector2(0, -9)
npc_name = "Pescador Ulrik"
lines = PackedStringArray("Cuarenta años pescando aquí. El mar da y el mar quita.", "Algo rompe mis redes por las noches. Lo anoté en el tablón del Gremio.")
shouts = PackedStringArray("Hoy hay buena pesca.", "Pican poco.")

