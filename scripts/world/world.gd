extends Node2D
## Valdoria overworld: camera bounds, district announcements, spawn markers and the citizens' walk graph.

@export var map_size := Vector2i(180, 140)
@export var walk_nodes := PackedVector2Array()
@export var walk_edges := PackedInt32Array()
## Doors of houses where townsfolk live (they walk in and out).
@export var home_points := PackedVector2Array()
## Spots in front of stalls where shoppers stand.
@export var shop_points := PackedVector2Array()
## Districts: name -> Rect2 in pixels. First match wins, so list small zones first.
@export var zones: Dictionary = {}
## Walkability grid generated by the world generator (the editor saves a .res next to it).
@export_file("*.png") var walkmask_path := "res://resources/world/walkmask.png"
## Wild maps: running drains stamina. In town you can run freely.
@export var run_uses_stamina := false
## Map picture for the minimap (2 px per tile) and its title on the full map.
@export_file("*.png") var minimap_path := ""
@export var map_title := ""
## Treasure chests: positions (px) and tier (0-4) of each one.
@export var chest_points := PackedVector2Array()
@export var chest_tiers := PackedInt32Array()
## Other hunters of the Guild roaming this map.
@export var hunter_count := 0

var _adj: Array[PackedInt32Array] = []
var _current_zone := ""

@onready var player: Player = $Entities/Player


func _enter_tree() -> void:
	add_to_group("world")


func _ready() -> void:
	_build_nav()
	player.add_to_group("player")
	_adj.resize(walk_nodes.size())
	for i in walk_nodes.size():
		_adj[i] = PackedInt32Array()
	for i in range(0, walk_edges.size(), 2):
		var a := walk_edges[i]
		var b := walk_edges[i + 1]
		_adj[a].append(b)
		_adj[b].append(a)
	var spawn: Node2D = null
	if Game.pending_spawn != "":
		spawn = get_node_or_null("Spawns/" + Game.pending_spawn) as Node2D
		if spawn == null and Game.pending_spawn == "respawn":
			spawn = get_node_or_null("Spawns/start") as Node2D
	if spawn:
		player.global_position = spawn.global_position
		player.facing = "down"
	Game.pending_spawn = ""
	Game.take_pending_position(player)
	player.reset_physics_interpolation()
	player.set_camera_limits(Rect2i(Vector2i.ZERO, map_size * 16))
	_spawn_chests()
	_spawn_hunters.call_deferred()
	var t := Timer.new()
	t.wait_time = 0.5
	t.autostart = true
	t.timeout.connect(_check_zone)
	add_child(t)
	_check_zone()


func _spawn_chests() -> void:
	if chest_points.is_empty():
		return
	var scene := load("res://scenes/objects/chest.tscn") as PackedScene
	var parent := get_node("Entities")
	for i in chest_points.size():
		var c := scene.instantiate()
		c.set("chest_id", "%s#%d" % [scene_file_path.get_file().get_basename(), i])
		c.set("tier", chest_tiers[i] if i < chest_tiers.size() else 0)
		c.position = chest_points[i]
		parent.add_child(c)


## Hunters: about half fight in the monster zones, the rest travel (some running) between landmarks.
func _spawn_hunters() -> void:
	if hunter_count <= 0:
		return
	var scene := load("res://scenes/npc/hunter.tscn") as PackedScene
	var map_area := float(map_size.x * map_size.y * 256)
	var areas: Array[Rect2] = []
	for z in zones:
		var r: Rect2 = zones[z]
		if r.get_area() < map_area * 0.3:
			areas.append(r)
	var marks: Array = []
	for r in areas:
		var p := _walkable_in(r)
		if p != Vector2.INF:
			marks.append(p)
	var entrance := player.global_position
	var sp := get_node_or_null("Spawns/south") as Node2D
	if sp:
		entrance = sp.global_position
	marks.append(entrance)
	var prey: Array = []
	for m in get_tree().get_nodes_in_group("monsters"):
		if not m.get("boss"):
			var near := false
			for q in prey:
				if (q as Node2D).global_position.distance_to(m.global_position) < 200.0:
					near = true
			if not near:
				prey.append(m)
	prey.shuffle()
	var roster: Array = GameData.HUNTERS.duplicate()
	roster.shuffle()
	for i in mini(hunter_count, roster.size()):
		var h: Dictionary = roster[i]
		var n := scene.instantiate()
		var role := "fighter" if i < hunter_count * 0.55 else ("runner" if i % 3 == 0 else "traveler")
		n.set("hunter_name", h["name"])
		n.set("level", h["level"])
		n.set("tier", h["tier"])
		n.set("line", h["line"])
		n.set("role", role)
		var home: Vector2 = marks[i % marks.size()]
		if role == "fighter" and prey.size() > 0:
			# settle next to a pack of monsters, each fighter at a different one
			var m: Node2D = prey.pop_back()
			var p := _walkable_in(Rect2(m.global_position - Vector2(40, 40), Vector2(80, 80)))
			home = p if p != Vector2.INF else m.global_position
		n.set("home", home)
		n.set("landmarks", marks)
		n.position = home if role == "fighter" else marks.pick_random()
		$Entities.add_child(n)


func _walkable_in(r: Rect2) -> Vector2:
	for i in 40:
		var p := r.position + Vector2(randf() * r.size.x, randf() * r.size.y)
		if is_walkable(p) and is_walkable(p + Vector2(8, 0)) and is_walkable(p - Vector2(8, 0)):
			return p
	return Vector2.INF


## Pathfinding grid built from res://resources/world/walkmask.png (8 px cells).
const NAV_CELL := 8
var nav: AStarGrid2D


func _build_nav() -> void:
	var img: Image = null
	var res_path := walkmask_path.get_basename() + ".res"
	if ResourceLoader.exists(res_path):
		img = load(res_path) as Image
	if img == null:
		var tex := load(walkmask_path) as Texture2D
		if tex == null:
			return
		img = tex.get_image()
	_build_nav_from(img)


## Rebuilds the walk grid from the live collision shapes (used by the map editor after edits).
func rebuild_walkmask() -> Image:
	var gw := map_size.x * 2
	var gh := map_size.y * 2
	var img := Image.create(gw, gh, false, Image.FORMAT_RGB8)
	var space := get_world_2d().direct_space_state
	var shape := RectangleShape2D.new()
	shape.size = Vector2(6, 6)
	var q := PhysicsShapeQueryParameters2D.new()
	q.shape = shape
	q.collision_mask = 1
	q.collide_with_areas = false
	var road := get_node_or_null("Road") as TileMapLayer
	var ground := get_node_or_null("Ground") as TileMapLayer
	for y in gh:
		for x in gw:
			q.transform = Transform2D(0, Vector2(x * NAV_CELL + 4, y * NAV_CELL + 4))
			var blocked := x == 0 or y == 0 or x == gw - 1 or not space.intersect_shape(q, 1).is_empty()
			var cell := Vector2i(x / 2, y / 2)
			var is_road := (road and road.get_cell_source_id(cell) != -1) or (ground and ground.get_cell_source_id(cell) == 0)
			img.set_pixel(x, y, Color(1.0 if blocked else 0.0, 1.0 if is_road else 0.0, 0.0))
	_build_nav_from(img)
	return img


func _build_nav_from(img: Image) -> void:
	nav = AStarGrid2D.new()
	nav.region = Rect2i(0, 0, img.get_width(), img.get_height())
	nav.cell_size = Vector2(NAV_CELL, NAV_CELL)
	nav.offset = Vector2(NAV_CELL / 2.0, NAV_CELL / 2.0)
	nav.diagonal_mode = AStarGrid2D.DIAGONAL_MODE_ONLY_IF_NO_OBSTACLES
	nav.default_compute_heuristic = AStarGrid2D.HEURISTIC_OCTILE
	nav.default_estimate_heuristic = AStarGrid2D.HEURISTIC_OCTILE
	nav.update()
	for y in img.get_height():
		for x in img.get_width():
			var c := img.get_pixel(x, y)
			if c.r > 0.5:
				nav.set_point_solid(Vector2i(x, y), true)
			elif c.g < 0.5:
				nav.set_point_weight_scale(Vector2i(x, y), 1.8)   # prefer streets over grass


func _free_cell(p: Vector2) -> Vector2i:
	var c := Vector2i(p / NAV_CELL)
	c = c.clamp(nav.region.position, nav.region.end - Vector2i.ONE)
	if not nav.is_point_solid(c):
		return c
	for r in range(1, 6):
		for dy in range(-r, r + 1):
			for dx in range(-r, r + 1):
				var q := c + Vector2i(dx, dy)
				if nav.region.has_point(q) and not nav.is_point_solid(q):
					return q
	return c


## Walkable route in pixels from `from` to `to`, simplified to its turning points.
func find_path(from: Vector2, to: Vector2) -> PackedVector2Array:
	if nav == null:
		return PackedVector2Array([to])
	var pts := nav.get_point_path(_free_cell(from), _free_cell(to), true)
	if pts.size() <= 2:
		return pts
	var out := PackedVector2Array([pts[0]])
	for i in range(1, pts.size() - 1):
		if (pts[i] - pts[i - 1]).normalized() != (pts[i + 1] - pts[i]).normalized():
			out.append(pts[i])
	out.append(pts[pts.size() - 1])
	return out


func is_walkable(p: Vector2) -> bool:
	if nav == null:
		return true
	var c := Vector2i(p / NAV_CELL)
	return nav.region.has_point(c) and not nav.is_point_solid(c)


func neighbors(i: int) -> PackedInt32Array:
	return _adj[i]


func node_position(i: int) -> Vector2:
	return walk_nodes[i]


func nearest_node(p: Vector2) -> int:
	var best := 0
	var best_d := INF
	for i in walk_nodes.size():
		var d := walk_nodes[i].distance_squared_to(p)
		if d < best_d:
			best_d = d
			best = i
	return best


## Breadth-first route between two graph nodes (excludes the start node).
func path(from: int, to: int) -> PackedInt32Array:
	if from == to:
		return PackedInt32Array()
	var came := {from: -1}
	var queue := [from]
	while not queue.is_empty():
		var n: int = queue.pop_front()
		if n == to:
			break
		for m in _adj[n]:
			if not came.has(m):
				came[m] = n
				queue.append(m)
	if not came.has(to):
		return PackedInt32Array()
	var out := PackedInt32Array()
	var c := to
	while c != from:
		out.insert(0, c)
		c = came[c]
	return out


## Random point from a list property within `radius` of `p` (or null).
func random_point_near(list_name: String, p: Vector2, radius: float) -> Variant:
	var pts: PackedVector2Array = get(list_name)
	var near := []
	for q in pts:
		if q.distance_to(p) < radius:
			near.append(q)
	if near.is_empty():
		return null
	return near.pick_random()


func _check_zone() -> void:
	var zone := ""
	for name in zones:
		if (zones[name] as Rect2).has_point(player.global_position):
			zone = name
			break
	if zone != "" and zone != _current_zone:
		_current_zone = zone
		Game.location_entered.emit(zone)
	elif zone == "":
		_current_zone = ""
